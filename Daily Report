// ---------------------------------------------------------------------------
// 4. Jira 연동 로직
// ---------------------------------------------------------------------------
function jiraAuthHeaders_() {
  const token = Utilities.base64Encode(`${JIRA_EMAIL}:${JIRA_API_TOKEN}`);
  return {
    Authorization: `Basic ${token}`,
    Accept: 'application/json',
    'Content-Type': 'application/json',
  };
}

function ymd_(dateObj) {
  return Utilities.formatDate(dateObj, TZ, 'yyyy-MM-dd');
}

function addDays_(dateObj, days) {
  return new Date(dateObj.getTime() + days * 24 * 60 * 60 * 1000);
}

function jiraSearchIssues_(jql, fields, maxResults, nextPageToken) {
  const url = JIRA_BASE_URL.replace(/\/$/, '') + '/rest/api/3/search/jql';
  const payload = {
    jql: jql,
    maxResults: maxResults || 50,
    fields: (fields && fields.length) ? fields : ["summary","assignee","duedate","status","priority","project"]
  };
  if (nextPageToken) payload.nextPageToken = nextPageToken;

  const authHeaders = jiraAuthHeaders_();
  const res = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    headers: {
      'Authorization': authHeaders.Authorization,
      'Accept': authHeaders.Accept,
      'Content-Type': authHeaders['Content-Type']
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  const code = res.getResponseCode();
  const text = res.getContentText();
  if (code < 200 || code >= 300) {
    throw new Error(`[Jira] search/jql failed: ${code} | ${text}`);
  }
  return JSON.parse(text);
}

function fetchJiraDueBucketsBySlackId_() {
  const jiraToSlack = {};
  const accountIds = [];
  ID_MAP.forEach(row => {
    if (row.jira) accountIds.push(row.jira);
    if (row.jira && row.slack) jiraToSlack[row.jira] = row.slack;
  });

  const assigneeClause = accountIds.map(id => `"${id}"`).join(',');
  const today = new Date();
  const todayStr = ymd_(today);
  const dueSoonEndStr = ymd_(addDays_(today, JIRA_DUE_SOON_DAYS));
  const overdueStartStr = ymd_(addDays_(today, -JIRA_OVERDUE_LOOKBACK_DAYS));

  const jql =
    `assignee in (${assigneeClause}) AND statusCategory != Done AND duedate is not EMPTY AND (` +
    `(duedate >= "${todayStr}" AND duedate <= "${dueSoonEndStr}") OR ` +
    `(duedate < "${todayStr}" AND duedate >= "${overdueStartStr}")` +
    `) ORDER BY duedate ASC`;

  const jiraFields = ["summary","duedate","assignee","status","priority","project"];
  let issues = [];
  let token = null;
  while (true) {
    const resp = jiraSearchIssues_(jql, jiraFields, 50, token);
    issues = issues.concat(resp.issues || []);
    token = resp.nextPageToken;
    if (!token) break;
  }

  const out = {};
  function ensure_(slackId) {
    if (!out[slackId]) out[slackId] = { overdue: [], dueSoon: [] };
    return out[slackId];
  }

  issues.forEach(issue => {
    const key = issue.key;
    const issueFields = issue.fields || {};
    const summary = issueFields.summary || '';
    const due = issueFields.duedate;
    const assignee = issueFields.assignee;
    const accountId = assignee && assignee.accountId;
    if (!key || !due || !accountId) return;

    const slackId = jiraToSlack[accountId];
    if (!slackId) return;

    const item = { key, summary, due, url: `${JIRA_BASE_URL}/browse/${key}` };
    if (due < todayStr && due >= overdueStartStr) {
      ensure_(slackId).overdue.push(item);
    } else if (due >= todayStr && due <= dueSoonEndStr) {
      ensure_(slackId).dueSoon.push(item);
    }
  });
  return out;
}

/**
 * [수정됨] 슬랙 제출 여부와 무관하게 JIRA 이슈를 리포트에 추가
 * - 다중 채널 환경을 위해 미제출자는 '미제출자 Jira 알림' 이라는 가상 채널(그룹)로 따로 분리합니다.
 */
function attachJiraDueToAggregated_(aggregated) {
  try {
    const dueMap = fetchJiraDueBucketsBySlackId_();
    
    // 1. 슬랙에 보고서를 작성한 멤버들에게 Jira 내용 붙이기
    aggregated.channels.forEach(ch => {
      ch.members.forEach(m => {
        const bucket = dueMap[m.id];
        if (!bucket) return;

        const lines = [];
        bucket.overdue.forEach(it => { lines.push(`- [JIRA OVERDUE] ${it.key}: ${it.summary} (due ${it.due})`); lines.push(it.url); });
        bucket.dueSoon.forEach(it => { lines.push(`- [JIRA DUE SOON] ${it.key}: ${it.summary} (due ${it.due})`); lines.push(it.url); });

        if (lines.length > 0) {
          m.backlog = appendBlock_(m.backlog, lines.join('\n'));
        }
        
        // 처리 완료된 멤버는 dueMap에서 제거
        delete dueMap[m.id];
      });
    });

    // 2. 슬랙 보고서를 쓰지 않았지만 Jira 티켓이 남아있는 멤버를 가상 채널 그룹으로 빼서 추가
    const missingMembersWithJira = [];
    Object.keys(dueMap).forEach(slackId => {
      const bucket = dueMap[slackId];
      const lines = [];
      
      bucket.overdue.forEach(it => { lines.push(`- [JIRA OVERDUE] ${it.key}: ${it.summary} (due ${it.due})`); lines.push(it.url); });
      bucket.dueSoon.forEach(it => { lines.push(`- [JIRA DUE SOON] ${it.key}: ${it.summary} (due ${it.due})`); lines.push(it.url); });

      if (lines.length > 0) {
        const memberName = TARGET_MEMBERS[slackId] || '이름 알 수 없음';
        missingMembersWithJira.push({
          id: slackId,
          name: memberName,
          duties: '-', // 빈 값으로 처리하여 출력 안 되게 함
          backlog: lines.join('\n'),
          time: '-'
        });
      }
    });

    // 가상 채널(그룹) 푸시
    if (missingMembersWithJira.length > 0) {
      aggregated.channels.push({
        name: '미제출자 JIRA 알림',
        id: 'jira_only',
        members: missingMembersWithJira
      });
    }

  } catch (e) {
    Logger.log('🚨 [Jira API Error] 데이터 조회 실패! 에러 원인을 확인하세요:');
    Logger.log(e.message);
  }
  return aggregated;
}

function appendBlock_(original, extra) {
  const orig = (original || '').trim();
  const ext = (extra || '').trim();
  if (!ext) return orig || '-';
  if (!orig || orig === '-') return ext;
  return orig + '\n' + ext;
}

