/**
 * [수정됨] AI 파서: 복잡한 링크/라벨 제거 및 JSON 파싱 안정성 강화
 */
function callOpenAIParser(text) {
  const url = "https://api.openai.com/v1/chat/completions";
  
  const systemPrompt = 
    "너는 '데이터 정제 및 추출 전문가'야. 입력된 텍스트에서 업무 보고 데이터를 구조화된 JSON으로 추출해.\n\n" +
    
    "**1. 기본 규칙 (isRelevant)**:\n" +
    "   - '완료된 업무'라는 어휘가 있고 업무와 관련된 내용(프로젝트명, 개발, 배포, 회의 등)이 포함되어 있으면 **true**.\n" +
    "   - 단순 잡담('퇴근합니다', '안녕하세요')인 경우나 '오늘의 업무'가 들어간 경우 false.\n\n" +

    "**2. 데이터 추출 규칙**:\n" +
    "   - **name**: 텍스트의 첫 번째 줄을 이름으로 간주하거나 '이름: OOO' 패턴에서 추출. 없으면 '미기입'.\n" +
    "   - **duties (완료한 업무)**: '완료한 업무', 'Today', '금일 업무' 등의 헤더 아래에 있는 항목들.\n" +
    "   - **backlog (백로그)**: '백로그', 'Backlog', '예정 업무' 등의 헤더 아래에 있는 항목들.\n\n" +

    "**3. 텍스트 정제 및 링크 처리 (가장 중요)**:\n" +
    "   - 모든 항목은 불렛 포인트(•, -)나 번호로 구분된 리스트 형태여야 함.\n" +
    "   - **한 줄에 텍스트와 링크가 섞여 있다면 반드시 줄바꿈(\\n)으로 분리해.**\n" +
    "   - **링크 라벨 제거**: '컨플루언스:', '지라:', 'Jira:', 'Wiki:', '링크:' 같은 텍스트는 **삭제**하고 순수 URL(http...)만 남겨.\n" +
    "   - 쉼표(,)로 구분된 여러 링크가 있다면 각각 새로운 줄에 배치해.\n\n" +
    
    "**[출력 예시]**\n" +
    "입력: '- 로그인 API 구현, 지라: http://jira..., 컨플루언스: http://wiki...'\n" +
    "출력 duties: '- 로그인 API 구현\\nhttp://jira...\\nhttp://wiki...'\n\n" +

    "**4. JSON 필드**: isRelevant(boolean), name(string), duties(string), backlog(string).";

  const options = {
    method: "post",
    headers: { "Authorization": "Bearer " + OPENAI_API_KEY, "Content-Type": "application/json" },
    payload: JSON.stringify({
      model: "gpt-4o",
      messages: [
        { role: "system", content: systemPrompt },
        { role: "user", content: text }
      ],
      response_format: { type: "json_object" }
    }),
    muteHttpExceptions: true
  };

  try {
    const res = UrlFetchApp.fetch(url, options);
    const content = JSON.parse(res.getContentText()).choices[0].message.content;
    const result = JSON.parse(content);

    // AI가 가끔 줄바꿈을 \n 대신 실제로 줄을 바꿔서 줄 수 있으므로 정리
    const duties = (result.duties || '- 내용 없음').trim();
    const backlog = (result.backlog || '-').trim();

    // 안전장치: AI가 false를 줘도, 내용에 '완료'나 '-' 같은 키워드가 있으면 강제로 true로 바꿈
    // "파싱실패"를 막기 위해 text 길이가 충분히 길면(예: 15자 이상) 업무보고로 간주
    const fallbackRelevant = text.includes('완료') || text.includes('업무') || text.length > 15;

    return {
      isRelevant: result.isRelevant === true || fallbackRelevant,
      name: result.name || "미기입",
      duties: duties,
      backlog: backlog
    };
  } catch (e) {
    Logger.log(`[AI 파싱 에러] ${e.message}`);
    // 에러 발생 시 "파싱실패"라고 뜨는 대신 원본 텍스트를 duties에 넣어서라도 보여줌
    return { 
        isRelevant: true, 
        name: '파싱오류(원본)', 
        duties: text, // 원본 텍스트라도 보여주기 위해
        backlog: '-' 
    };
  }
}

/**
 * 일반 텍스트 Slack 메시지 전송
 * @param {string} channelId - Slack channel ID
 * @param {string} text - Message body
 */
function postToSlack(channelId, text) {
  UrlFetchApp.fetch('https://slack.com/api/chat.postMessage', {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: 'Bearer ' + SLACK_TOKEN },
    payload: JSON.stringify({ channel: channelId, text: text }),
    muteHttpExceptions: true
  });
}

/**
 * Block Kit 형식의 Slack 메시지 전송 (리치 포맷)
 * @param {string} channelId - Slack channel ID
 * @param {string} fallbackText - 알림에 표시될 plain text
 * @param {Array} blocks - Slack Block Kit blocks 배열
 */
function postBlocksToSlack(channelId, fallbackText, blocks) {
  UrlFetchApp.fetch('https://slack.com/api/chat.postMessage', {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: 'Bearer ' + SLACK_TOKEN },
    payload: JSON.stringify({
      channel: channelId,
      text: fallbackText,
      blocks: blocks
    }),
    muteHttpExceptions: true
  });
}

