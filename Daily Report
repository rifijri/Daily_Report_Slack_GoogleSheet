}

/**
 * [수정됨] 스마트 수집 로직
 * - 한 유저가 여러 개의 메시지를 썼을 경우,
 * - 최신 메시지부터 순서대로 AI에게 물어봐서 "업무 보고가 맞다"고 한 첫 번째 메시지를 채택합니다.
 * - 잡담("제출함", "수정함")이 최신이어도 건너뛰고 진짜 보고서를 찾아냅니다.
 * [수정됨] 스마트 수집 로직 (키워드 우선순위 적용)
 * 1순위: '완료한 업무' 텍스트가 포함된 메시지 우선 채택
 * 2순위: (없을 경우) 가장 최신 메시지 중 AI가 인정한 것 채택
 */
function collectAllChannelsData(oldest) {
  const now = new Date();
  const dateStr = Utilities.formatDate(new Date(), TZ, DATE_FORMAT);
  const channels = [];

  Logger.log('=== 스마트 데이터 수집 시작 (키워드 우선) ===');

  CHANNELS.forEach((ch, index) => {
    if (index > 0) Utilities.sleep(400);
    
    // 1. 메시지 가져오기
    const messages = fetchSlackHistory(ch.id, oldest);
    Logger.log(`[${ch.name}] 총 메시지 수: ${messages.length}`);

    // 2. 유저별 그룹화
    const userMessagesMap = {};
    messages.forEach(msg => {
      if (!userMessagesMap[msg.user]) {
        userMessagesMap[msg.user] = [];
      }
      userMessagesMap[msg.user].push(msg);
    });

    const members = [];

    // 3. 각 유저별로 '진짜 보고서' 찾기
    Object.keys(userMessagesMap).forEach(userId => {
      const userMsgs = userMessagesMap[userId]; // 최신순 정렬됨
      
      Logger.log(` -> 사용자(${userId}) 메시지 ${userMsgs.length}개 검사`);

      // [핵심 변경 1] 키워드("완료한 업무" 등)가 포함된 메시지를 먼저 찾습니다.
      let targetMsg = userMsgs.find(msg => /완료\s*한\s*업무|완료\s*업무|완료한업무/.test(msg.text));
      let found = false;

      // [핵심 변경 2] 키워드 메시지가 있다면 우선적으로 AI 파싱 시도
      if (targetMsg) {
        Logger.log(`    => [키워드 발견] "완료한 업무" 포함 메시지 우선 검사`);
        const extracted = callOpenAIParser(targetMsg.text);
        
        if (extracted.isRelevant) {
          pushMemberData(members, targetMsg, extracted);
          found = true;
          Logger.log(`    => [채택] 키워드 메시지 채택 완료`);
        } else {
          Logger.log(`    => [반려] 키워드는 있었으나 AI가 업무 보고가 아니라고 판단함.`);
        }
      }

      // [핵심 변경 3] 키워드 메시지로 해결이 안 됐다면, 기존 방식(최신순 탐색)으로 Fallback
      if (!found) {
        if (targetMsg) Logger.log(`    => [재검사] 일반 모드로 최신 글부터 다시 탐색합니다.`);
        
        for (let i = 0; i < userMsgs.length; i++) {
          const msg = userMsgs[i];
          
          // 아까 검사했다가 실패한 키워드 메시지는 중복 검사 생략
          if (targetMsg && msg.ts === targetMsg.ts) continue;

          const extracted = callOpenAIParser(msg.text);
          if (extracted.isRelevant) {
             Logger.log(`    => [일반 채택] 최신 메시지 발견 (내용: ${msg.text.substring(0, 20)}...)`);
             pushMemberData(members, msg, extracted);
             found = true;
             break; // 찾았으니 종료
          }
        }
      }
      
      if (!found) {
         Logger.log(`    => [실패] 유효한 업무 보고를 찾지 못함`);
      }
    });

    channels.push({ name: ch.name, id: ch.id, members: members });
  });

  return { dateStr: dateStr, channels: channels };
}

// [내부 헬퍼 함수] 멤버 데이터 배열에 추가하는 로직 (중복 코드 방지)
function pushMemberData(membersArray, msg, extracted) {
  const time = Utilities.formatDate(new Date(msg.ts * 1000), TZ, TIME_FORMAT);
  membersArray.push({
    id: msg.user,
    name: String(extracted.name),
    duties: String(extracted.duties),
    backlog: String(extracted.backlog),
    time: time
  });
}

/**
 * AI에게 전체 채널 데이터를 넘겨 채널별·멤버별 종합 보고서 문단 생성
 * @param {{ dateStr: string, channels: Array }} aggregated - collectAllChannelsData 반환값
 * @returns {string} - 보고서 본문 텍스트
 */
function callOpenAIComprehensiveReport(aggregated) {
  const systemPrompt =
    'You are a daily report summarizer. Given structured data from 5 Slack channels (po, data ai, designer, platform engineer, swe), ' +
    'produce a comprehensive report in Korean. Structure:\n' +
    '1. 전체 요약 (Executive summary): 2–3 sentences on overall activity and highlights.\n' +
    '2. 채널별 요약: For each channel, write a short paragraph summarizing the channel (member count, main themes, notable backlogs).\n' +
    '3. 멤버별 정리: For each member, one line: [채널명] 이름 – 완료 업무 요약; 백로그 있으면 간단히.\n' +
    'Keep the tone professional and concise. Output only the report body, no JSON or meta-commentary.';

  const userPayload = JSON.stringify(aggregated, null, 2);

  const options = {
    method: 'post',
    headers: { Authorization: 'Bearer ' + OPENAI_API_KEY, 'Content-Type': 'application/json' },
    payload: JSON.stringify({
      model: 'gpt-4o',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userPayload }
      ]
    }),
    muteHttpExceptions: true
  };

  try {
    const res = UrlFetchApp.fetch(OPENAI_CHAT_URL, options);
    const raw = res.getContentText();
    const parsed = JSON.parse(raw);
    const content = parsed.choices && parsed.choices[0] && parsed.choices[0].message && parsed.choices[0].message.content;
    return content ? String(content).trim() : '';
  } catch (e) {
    return '';
  }
}

/**
 * @param {{ id: string, name: string }} ch - Channel config
 * @param {string} dateStr - yyyyMMdd
 * @param {GoogleAppsScript.Drive.Folder} folder - Target Drive folder
 * @param {number} oldest - Unix timestamp (seconds) for Slack history
 */
function processChannel(ch, dateStr, folder, oldest) {
  const fileName = `${dateStr}_${ch.name}`;
