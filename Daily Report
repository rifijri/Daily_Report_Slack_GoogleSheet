/**
 * 전일 업무 브리핑 생성 후 Slack에 Block Kit으로 포스팅
 */
function createAndPostDailyBriefing() {
  const oldest = getOldestTimestampSince7amKst();
  const aggregated = collectAllChannelsData(oldest);
  const totalCount = aggregated.channels.reduce(function (sum, ch) { return sum + ch.members.length; }, 0);
  if (totalCount === 0) return;

  const summaries = callOpenAIThreeSummaries(aggregated);
  const blocks = buildBriefingBlocks(aggregated, totalCount, summaries);

  if (BRIEFING_CHANNEL_ID) {
    postBlocksToSlack(BRIEFING_CHANNEL_ID, '전일 업무 브리핑', blocks);
  }
  return blocks;
}

/**
 * Block Kit 블록 배열 생성: 헤더 + 요약 + 채널별 멤버 섹션
 * @param {{ dateStr: string, channels: Array }} aggregated
 * @param {number} totalCount
 * @param {string[]} summaries
 * @returns {Array} - Slack blocks
 */
function buildBriefingBlocks(aggregated, totalCount, summaries) {
  const dateLabel = Utilities.formatDate(new Date(), TZ, DATE_BRIEFING_FORMAT);
  const blocks = [];

  // 1. 헤더 및 총 건수
  blocks.push({
    type: 'header',
    text: { type: 'plain_text', text: ':clipboard: 전일 업무 브리핑 | ' + dateLabel, emoji: true }
  });
  blocks.push({
    type: 'section',
    text: { type: 'mrkdwn', text: '어제 총 ' + totalCount + '건의 업무가 보고되었습니다.' }
  });
  blocks.push({ type: 'divider' });

  // 2. 3줄 요약
  blocks.push({
    type: 'section',
    text: {
      type: 'mrkdwn',
      text: '*핵심 3줄 요약*\n'
        + '1. ' + (summaries[0] || '-') + '\n'
        + '2. ' + (summaries[1] || '-') + '\n'
        + '3. ' + (summaries[2] || '-')
    }
  });

  blocks.push({ type: 'divider' });
  blocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*:bar_chart: 상세 업무 현황*' } });

  // 3. 채널별 본문 (블록 개수 제한 회피를 위해 채널별로 텍스트를 합칩니다)
  aggregated.channels.forEach(ch => {
    if (ch.members.length === 0) return;

    const channelHeader = `*:file_folder: ${ch.name.toUpperCase()} 팀*`;
    let channelBody = "";

    ch.members.forEach(m => {
      // 각 멤버의 내용을 텍스트로 누적
      channelBody += formatMemberBlock(m) + "\n\n";
    });

    // 텍스트가 너무 길어지는 것을 방지 (Slack 섹션당 3000자 제한 안전장치)
    if (channelBody.length > 2900) {
      channelBody = channelBody.substring(0, 2900) + "...(내용 생략됨)";
    }

    // 채널 하나당 1개의 블록만 생성
    blocks.push({
      type: "section",
      text: {
        type: "mrkdwn",
        text: `${channelHeader}\n${channelBody}`
      }
    });

    blocks.push({ type: 'divider' });
  });

  return blocks;
}


/**
 * [수정됨] Slack 메시지 포맷터(한 명분의 라인 생성)
 * - 일반 업무: 앞에 '• ' 붙임
 * - 링크(http): 앞에 불렛 없이 공백('    ')만 붙여서 들여쓰기 처리
 */

function formatMemberBlock(m) {
  const lines = ['*' + m.name + '*'];
  
  // 빈 줄이나 의미 없는 문자 제거 헬퍼
  const clean = (txt) => (txt === '-' || !txt) ? [] : txt.split(/\r?\n/).filter(line => line.trim() !== '');
  
  // 포맷팅 로직
  const processLines = (textArray) => {
    textArray.forEach(line => {
      let trimmed = line.trim();
      
      // 혹시 이미 붙어있는 불렛 기호 제거
      trimmed = trimmed.replace(/^[-•*]\s*/, '');

      if (trimmed.startsWith('http')) {
        // [링크인 경우] 불렛 없이 들여쓰기(공백 4칸)만 적용
        lines.push(`    ${trimmed}`); 
      } else {
        // [일반 텍스트인 경우] 업무/백로그 구분 없이 모두 불렛(•) 적용
        lines.push(` • ${trimmed}`);
      }
    });
  };

  const duties = clean(m.duties);
  if (duties.length > 0) {
    lines.push('_완료한 업무:_');
    processLines(duties);
  }

  const backlog = clean(m.backlog);
  if (backlog.length > 0) {
    lines.push('_백로그:_');
    processLines(backlog);
  }
  
  return lines.join('\n');
}

/**
 * 줄바꿈으로 분리된 문자열에서 bullet prefix를 정리하고 빈 줄 제거
 * @param {string} text
 * @returns {string[]}
 */
function cleanBullets(text) {
  if (!text || text.trim() === '-' || text.trim() === '') return [];
  return text
    .split(/\r?\n/)
    .map(function (s) { return s.trim().replace(/^[-•*]\s*/, ''); })
    .filter(function (s) { return s.length > 0; });
}

/**
 * AI에게 전체 데이터를 주고 핵심 3줄 요약만 JSON으로 반환
 * @param {{ dateStr: string, channels: Array }} aggregated
 * @returns {string[]} - 길이 3 배열
 */
function callOpenAIThreeSummaries(aggregated){
  const systemPrompt =
    'You are a daily report summarizer. Given structured data from 5 Slack channels, ' +
    'output exactly 3 short summary sentences in Korean for "핵심 3줄 요약". ' +
    'Each sentence should capture one key outcome, decision, or risk (e.g. project progress, meeting result, delay reason). ' +
    'Output only a JSON object with a single key "summaries" (array of exactly 3 strings). No other text.';

  const options = {
    method: 'post',
    headers: { Authorization: 'Bearer ' + OPENAI_API_KEY, 'Content-Type': 'application/json' },
    payload: JSON.stringify({
      model: 'gpt-4o',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: JSON.stringify(aggregated, null, 2) }
      ],
      response_format: { type: 'json_object' }
    }),
    muteHttpExceptions: true
  };

  try {
    const res = UrlFetchApp.fetch(OPENAI_CHAT_URL, options);
    const raw = res.getContentText();
    const parsed = JSON.parse(raw);
    const content = parsed.choices && parsed.choices[0] && parsed.choices[0].message && parsed.choices[0].message.content;
    if (!content) return ['', '', ''];
    const result = JSON.parse(content);
    const arr = result.summaries && Array.isArray(result.summaries) ? result.summaries : [];
    return [arr[0] || '', arr[1] || '', arr[2] || ''];
  } catch (e) {
    return ['', '', ''];
  }
}
