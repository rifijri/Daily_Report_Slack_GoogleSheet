function createComprehensiveReport() {
  const dateStr = Utilities.formatDate(new Date(), TZ, DATE_FORMAT);
  const folder = DriveApp.getFolderById(FOLDER_ID);
  const oldest = getOldestTimestampSince7amKst();

  const aggregated = collectAllChannelsData(oldest);
  attachJiraDueToAggregated_(aggregated);
  const reportText = callOpenAIComprehensiveReport(aggregated);
  if (!reportText || !reportText.trim()) return;

  const docName = `${dateStr}_종합보고서`;
  const doc = DocumentApp.create(docName);
  const body = doc.getBody();
  body.clear();
  body.appendParagraph(`일일 종합 보고서 (${aggregated.dateStr})`).setHeading(DocumentApp.ParagraphHeading.TITLE);
  body.appendHorizontalRule();
  reportText.split(/\n\n+/).forEach((block) => {
    if (block.trim()) body.appendParagraph(block.trim());
  });
  DriveApp.getFileById(doc.getId()).moveTo(folder);
}

function collectAllChannelsData(oldest) {
  const dateStr = Utilities.formatDate(new Date(), TZ, DATE_FORMAT);
  const channels = [];

  Logger.log('=== 스마트 데이터 수집 시작 (키워드 우선) ===');

  CHANNELS.forEach((ch, index) => {
    if (index > 0) Utilities.sleep(400);
    
    const messages = fetchSlackHistory(ch.id, oldest);
    Logger.log(`[${ch.name}] 총 메시지 수: ${messages.length}`);

    const userMessagesMap = {};
    messages.forEach(msg => {
      if (!userMessagesMap[msg.user]) {
        userMessagesMap[msg.user] = [];
      }
      userMessagesMap[msg.user].push(msg);
    });

    const members = [];

    Object.keys(userMessagesMap).forEach(userId => {
      const userMsgs = userMessagesMap[userId];
      
      let targetMsg = userMsgs.find(msg => msg.text && /완료\s*한\s*업무|완료\s*업무|완료한업무/.test(msg.text));
      let found = false;

      if (targetMsg) {
        const extracted = callOpenAIParser(targetMsg.text);
        if (extracted.isRelevant) {
          pushMemberData(members, targetMsg, extracted);
          found = true;
        }
      }

      if (!found) {
        for (let i = 0; i < userMsgs.length; i++) {
          const msg = userMsgs[i];
          if (targetMsg && msg.ts === targetMsg.ts) continue;
          if (!msg.text) continue;
          
          const extracted = callOpenAIParser(msg.text);
          if (extracted.isRelevant) {
             pushMemberData(members, msg, extracted);
             found = true;
             break;
          }
        }
      }
    });

    channels.push({ name: ch.name, id: ch.id, members: members });
  });

  return { dateStr: dateStr, channels: channels };
}

function pushMemberData(membersArray, msg, extracted) {
  const time = Utilities.formatDate(new Date(msg.ts * 1000), TZ, TIME_FORMAT);
  // [수정됨] TARGET_MEMBERS 기반의 실명을 1순위로 강제 사용
  const actualName = TARGET_MEMBERS[msg.user] || extracted.name || "미기입";

  membersArray.push({
    id: msg.user,
    name: actualName,
    duties: String(extracted.duties),
    backlog: String(extracted.backlog),
    time: time
  });
}

function fetchSlackHistory(channelId, oldest) {
  const url = `https://slack.com/api/conversations.history?channel=${channelId}&oldest=${oldest}`;
  const res = UrlFetchApp.fetch(url, {
    headers: { Authorization: 'Bearer ' + SLACK_TOKEN },
    muteHttpExceptions: true
  });
  const data = JSON.parse(res.getContentText());
  if (!data.ok || !data.messages) return [];
  return data.messages.filter(msg => !msg.bot_id && !msg.subtype);
}

function getLatestReportPerUser(messages) {
  const map = new Map();
  messages.forEach(msg => { if (!map.has(msg.user)) map.set(msg.user, msg); });
  return map;
}

function buildDataRows(reportsMap) {
  const rows = [];
  let count = 1;
  reportsMap.forEach((msg) => {
    if (!msg.text) return;
    const extracted = callOpenAIParser(msg.text);
    if (!extracted.isRelevant) return;
    const time = Utilities.formatDate(new Date(msg.ts * 1000), TZ, TIME_FORMAT);
    rows.push([
      count++,
      time,
      String(extracted.name),
      String(extracted.duties),
      String(extracted.backlog)
    ]);
  });
  return rows;
}

function processChannel(ch, dateStr, folder, oldest) {
  const fileName = `${dateStr}_${ch.name}`;
  const ss = SpreadsheetApp.create(fileName);
  const sheet = ss.getSheets()[0];
  DriveApp.getFileById(ss.getId()).moveTo(folder);

  sheet.appendRow(HEADER_ROW);

  const messages = fetchSlackHistory(ch.id, oldest);
  const reportsMap = getLatestReportPerUser(messages);
  const rows = buildDataRows(reportsMap);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, NUM_COLUMNS).setValues(rows);
  }

  applyExcelStyle(sheet);
}

function applyExcelStyle(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow <= 1) return;

  const header = sheet.getRange(1, 1, 1, NUM_COLUMNS);
  header
    .setBackground('#333333')
    .setFontColor('#ffffff')
    .setFontWeight('bold')
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle');

  sheet.setColumnWidth(1, 45);
  sheet.setColumnWidth(2, 90);
  sheet.setColumnWidth(3, 100);
  sheet.setColumnWidth(4, 500);
  sheet.setColumnWidth(5, 300);

  for (let i = 2; i <= lastRow; i++) {
    if (i % 2 === 0) sheet.getRange(i, 1, 1, NUM_COLUMNS).setBackground('#f8f8f8');
  }

  sheet.getRange(1, 1, lastRow, NUM_COLUMNS).setBorder(true, true, true, true, true, true, '#d9d9d9', SpreadsheetApp.BorderStyle.SOLID);
  sheet.getRange(2, 1, lastRow - 1, 3).setHorizontalAlignment('center');
  sheet.getRange(2, 4, lastRow - 1, 2).setVerticalAlignment('top').setWrap(true);
  sheet.setFrozenRows(1);
}

