  const aggregated = collectAllChannelsData(oldest);
  attachJiraDueToAggregated_(aggregated);
  
  const totalCount = aggregated.channels.reduce((sum, c) => sum + c.members.length, 0);
  
  if (totalCount === 0) {
    Logger.log('수집된 업무 보고가 0건이므로 리포트를 생성하지 않고 종료합니다.');
    return;
  }

  const folder = DriveApp.getFolderById(FOLDER_ID);

  aggregated.channels.forEach(ch => {
    const dateStr = Utilities.formatDate(yesterday, TZ, DATE_FORMAT); // ENB의 새벽 실행 기준 파일명
    const fileName = `${dateStr}_${ch.name}`;
    if (ch.id === 'jira_only') return;
    
    const ss = SpreadsheetApp.create(fileName);
    const sheet = ss.getSheets()[0];
    DriveApp.getFileById(ss.getId()).moveTo(folder);
    
    sheet.appendRow(HEADER_ROW);
    
    const rows = [];
    ch.members.forEach((m, i) => {
      // 전사 포맷 시트 데이터 삽입
      rows.push([i + 1, m.time, m.name, m.yesterday, m.today, m.challenges]);
    });
    
    if (rows.length > 0) sheet.getRange(2, 1, rows.length, NUM_COLUMNS).setValues(rows);
    applyExcelStyle(sheet);
  });

  const summaries = callOpenAIThreeSummaries(aggregated);
  const blocks = buildBriefingBlocks(aggregated, totalCount, summaries);
  
  if (BRIEFING_CHANNEL_ID) {
    postBlocksToSlack(BRIEFING_CHANNEL_ID, '전일 업무 브리핑', blocks);
  }
}

/** =========================
 * Jira helpers
 * ========================= */

function jiraAuthHeaders_() {
  const token = Utilities.base64Encode(`${JIRA_EMAIL}:${JIRA_API_TOKEN}`);
  return { Authorization: `Basic ${token}`, Accept: 'application/json', 'Content-Type': 'application/json' };
}

function ymd_(dateObj) { return Utilities.formatDate(dateObj, TZ, 'yyyy-MM-dd'); }
function addDays_(dateObj, days) { return new Date(dateObj.getTime() + days * 24 * 60 * 60 * 1000); }

function jiraSearchIssues_(jql, fields, maxResults, nextPageToken) {
  const url = JIRA_BASE_URL.replace(/\/$/, '') + '/rest/api/3/search/jql';
  const payload = {
    jql: jql, maxResults: maxResults || 50,
    fields: (fields && fields.length) ? fields : ["summary","assignee","duedate","status","priority","project"]
  };
  if (nextPageToken) payload.nextPageToken = nextPageToken;

  const authHeaders = jiraAuthHeaders_();
  const res = UrlFetchApp.fetch(url, {
    method: 'post', contentType: 'application/json',
    headers: { 'Authorization': authHeaders.Authorization, 'Accept': authHeaders.Accept, 'Content-Type': authHeaders['Content-Type'] },
    payload: JSON.stringify(payload), muteHttpExceptions: true
  });
  return JSON.parse(res.getContentText());
}

function fetchJiraDueBucketsBySlackId_() {
  const jiraToSlack = {};
  const accountIds = [];
  ID_MAP.forEach(row => {
    if (row.jira) accountIds.push(row.jira);
    if (row.jira && row.slack) jiraToSlack[row.jira] = row.slack;
  });

  const assigneeClause = accountIds.map(id => `"${id}"`).join(',');
  const today = new Date();
  const todayStr = ymd_(today);
  const dueSoonEndStr = ymd_(addDays_(today, JIRA_DUE_SOON_DAYS));
  const overdueStartStr = ymd_(addDays_(today, -JIRA_OVERDUE_LOOKBACK_DAYS));

  const jql =
    `assignee in (${assigneeClause}) AND statusCategory != Done AND duedate is not EMPTY AND (` +
    `(duedate >= "${todayStr}" AND duedate <= "${dueSoonEndStr}") OR ` +
    `(duedate < "${todayStr}" AND duedate >= "${overdueStartStr}")` +
    `) ORDER BY duedate ASC`;

  let issues = [];
  let token = null;

  while (true) {
    const resp = jiraSearchIssues_(jql, ["summary","duedate","assignee","status","priority","project"], 50, token);
    issues = issues.concat(resp.issues || []);
    token = resp.nextPageToken;
    if (!token) break; 
  }

  const out = {};
  function ensure_(slackId) {
    if (!out[slackId]) out[slackId] = { overdue: [], dueSoon: [] };
    return out[slackId];
  }

  issues.forEach(issue => {
    const key = issue.key;
    const due = issue.fields?.duedate;
    const accountId = issue.fields?.assignee?.accountId;
    if (!key || !due || !accountId) return;

    const slackId = jiraToSlack[accountId];
    if (!slackId) return;

    const item = { key, summary: issue.fields.summary || '', due, url: `${JIRA_BASE_URL}/browse/${key}` };
    if (due < todayStr && due >= overdueStartStr) ensure_(slackId).overdue.push(item);
    else if (due >= todayStr && due <= dueSoonEndStr) ensure_(slackId).dueSoon.push(item);
  });
  return out;
}

function attachJiraDueToAggregated_(aggregated) {
  try {
    const dueMap = fetchJiraDueBucketsBySlackId_();
    
    // 전사 기준에 따라 Jira 티켓은 '오늘 할 일' 쪽에 붙입니다.
    aggregated.channels.forEach(ch => {
      ch.members.forEach(m => {
        const bucket = dueMap[m.id];
        if (!bucket) return;

        const lines = [];
        bucket.overdue.forEach(it => { lines.push(`- [JIRA OVERDUE] ${it.key}: ${it.summary} (due ${it.due})\n${it.url}`); });
        bucket.dueSoon.forEach(it => { lines.push(`- [JIRA DUE SOON] ${it.key}: ${it.summary} (due ${it.due})\n${it.url}`); });

        if (lines.length > 0) {
          m.today = appendBlock_(m.today, lines.join('\n'));
        }
        delete dueMap[m.id];
      });
    });

    // 슬랙 미제출자여도 Jira 티켓이 있으면 브리핑에 추가
    if (aggregated.channels.length > 0) {
      const mainChannel = aggregated.channels[0];
      Object.keys(dueMap).forEach(slackId => {
        const bucket = dueMap[slackId];
        const lines = [];
        
        bucket.overdue.forEach(it => { lines.push(`- [JIRA OVERDUE] ${it.key}: ${it.summary} (due ${it.due})\n${it.url}`); });
        bucket.dueSoon.forEach(it => { lines.push(`- [JIRA DUE SOON] ${it.key}: ${it.summary} (due ${it.due})\n${it.url}`); });

        if (lines.length > 0) {
          mainChannel.members.push({
            id: slackId,
            name: TARGET_MEMBERS[slackId] || '이름 알 수 없음',
            yesterday: '-',
            today: lines.join('\n'), // Jira 이슈를 today(오늘 할 일)에 추가
            challenges: '-',
            time: '-'
          });
        }
      });
    }
  } catch (e) {
    Logger.log('🚨 [Jira API Error]: ' + e.message);
  }
  return aggregated;
}

function appendBlock_(original, extra) {
  const orig = (original || '').trim();
  const ext = (extra || '').trim();
  if (!ext) return orig || '-';
  if (!orig || orig === '-') return ext;
  return orig + '\n' + ext;
}

