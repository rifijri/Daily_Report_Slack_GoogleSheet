  const missingMembers = [];
  Object.keys(TARGET_MEMBERS).forEach(targetId => {
    if (!submittedIds.has(targetId)) missingMembers.push(`<@${targetId}>`);
  });

  if (missingMembers.length > 0) {
    const mentions = missingMembers.join(' '); 
    const blocks = [
      { "type": "header", "text": { "type": "plain_text", "text": "일일 업무 보고 제출 재알림" } },
      { "type": "section", "text": { "type": "mrkdwn", "text": "금일 *업무 보고*를 아직 작성하지 않으셨습니다.\n확인 후 작성을 부탁드립니다." } },
      { "type": "divider" },
      { "type": "section", "text": { "type": "mrkdwn", "text": `*대상자:*\n${mentions}` } },
      { "type": "context", "elements": [{ "type": "mrkdwn", "text": "이미 작성하셨다면 `*전날 한 일*` 또는 `*오늘 할 일*` 이라는 키워드가 포함되어 있는지 확인해주세요." }] }
    ];
    postBlocksToSlack(BRIEFING_CHANNEL_ID, "업무 보고 제출 재알림", blocks);
