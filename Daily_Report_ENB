function buildBriefingBlocks(aggregated, totalCount, summaries) {
  const dateLabel = Utilities.formatDate(new Date(), TZ, DATE_BRIEFING_FORMAT);
  const blocks = [];

  // 1. 헤더
  blocks.push({
    type: 'header',
    text: { type: 'plain_text', text: ':clipboard: 전일 업무 브리핑 | ' + dateLabel, emoji: true }
  });
  blocks.push({
    type: 'section',
    text: { type: 'mrkdwn', text: '어제 총 ' + totalCount + '건의 업무가 보고되었습니다.' }
  });
  blocks.push({ type: 'divider' });

  // 2. 3줄 요약
  blocks.push({
    type: 'section',
    text: {
      type: 'mrkdwn',
      text: '*핵심 3줄 요약*\n'
        + '1. ' + (summaries[0] || '-') + '\n'
        + '2. ' + (summaries[1] || '-') + '\n'
        + '3. ' + (summaries[2] || '-')
    }
  });
  blocks.push({ type: 'divider' });
  blocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*:bar_chart: 상세 업무 현황*' } });

  // 3. 채널별 본문
  aggregated.channels.forEach(ch => {
    if (ch.members.length === 0) return;

    const channelHeader = `*Corporate Operator 셀*`;
    
    // [수정 핵심] 문자열 덧셈 대신 배열을 사용해 간격과 꼬리 공백을 완벽하게 통제합니다.
    const memberTexts = [];

    ch.members.forEach(m => {
      const blockText = formatMemberBlock(m);
      
      // 내용이 비어있지 않은 경우에만, 텍스트 앞뒤의 불필요한 줄바꿈을 완벽히 잘라내고 배열에 넣습니다.
      if (blockText && blockText.trim() !== "") {
        memberTexts.push(blockText.trim());
      }
    });

    // 출력할 멤버가 없으면 생략
    if (memberTexts.length === 0) return;

    // [간격 조절 부분] 멤버 사이를 무조건 지정된 줄바꿈으로만 연결합니다.
    // - \n\n : 일반적인 1줄 띄어쓰기 (문단 구분)
    // - \n\n\n : 더 확실한 2줄 띄어쓰기
    let channelBody = memberTexts.join('\n\n\n');

    // 슬랙 블록 글자 수 제한 안전장치
    if (channelBody.length > 2900) {
      channelBody = channelBody.substring(0, 2900) + "...(내용 생략됨)";
    }

    blocks.push({
      type: "section",
      text: {
        type: "mrkdwn",
        text: `${channelHeader}\n\n${channelBody}`
      }
    });

    blocks.push({ type: 'divider' });
  });

  return blocks;
}

function formatMemberBlock(m) {
  // 빈 줄이나 의미 없는 문자 제거 헬퍼
  const clean = (txt) => {
    if (!txt || txt === '-') return [];
    return txt.split(/\r?\n/).filter(line => {
      const rawText = line.replace(/^[-•*]\s*/, '').trim();
      return rawText !== '' && rawText !== '내용 없음' && rawText !== '내용없음';
    });
  };

  const duties = clean(m.duties);
  const backlog = clean(m.backlog);

  // [수정됨] 완료한 업무와 백로그가 둘 다 없으면 빈 문자열을 반환하여 아예 출력하지 않음
  if (duties.length === 0 && backlog.length === 0) {
    return "";
  }

  const lines = ['*' + m.name + '*'];
  
  // 포맷팅 로직
  const processLines = (textArray) => {
    textArray.forEach(line => {
      let trimmed = line.trim();
      trimmed = trimmed.replace(/^[-•*]\s*/, '');

      if (trimmed.startsWith('http')) {
        lines.push(`    ${trimmed}`); 
      } else {
        lines.push(` • ${trimmed}`);
      }
    });
  };

  if (duties.length > 0) {
    lines.push('_완료한 업무:_');
    processLines(duties);
  }

  if (backlog.length > 0) {
    lines.push('_백로그:_');
    processLines(backlog);
  }
  
  return lines.join('\n');
}

