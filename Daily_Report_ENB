/**
 * [수정됨] 매일 밤 23시에 실행: 미제출자 확인 및 멘션 알림
 * - TARGET_MEMBERS의 값(Slack ID)을 기준으로 체크하도록 수정
 */
function sendUnsubmittedReminder() {
  // 1. 주말 체크 (주말 밤에는 알림 끄기)
  const dayOfWeek = Utilities.formatDate(new Date(), TZ, 'EEE');
  if (dayOfWeek === 'Sat' || dayOfWeek === 'Sun') {
    Logger.log('주말(' + dayOfWeek + ') 밤이므로 미제출 알림을 보내지 않습니다.');
    return;
  }

  const oldest = getOldestTimestampSince7amKst();
  
  // 2. 현재까지 제출된 데이터 수집
  const aggregated = collectAllChannelsData(oldest);
  
  // 3. 제출한 멤버들의 ID 목록 추출
  const submittedIds = new Set();
  aggregated.channels.forEach(ch => {
    ch.members.forEach(m => submittedIds.add(m.id));
  });

  // 4. 미제출자 찾기 (수정된 부분)
  const missingMembers = [];
  
  // [중요 수정] TARGET_MEMBERS가 {이메일: ID} 형식이므로, 
  // Object.keys(ID)를 사용해야 합니다.
  Object.keys(TARGET_MEMBERS).forEach(targetId => {
    if (!submittedIds.has(targetId)) {
      missingMembers.push(`<@${targetId}>`);
    }
  });

  // 5. 알림 전송 (Block Kit)
  if (missingMembers.length > 0) {
    const mentions = missingMembers.join(' '); 
    const blocks = [
      {
        "type": "header",
        "text": { "type": "plain_text", "text": "일일 업무 보고 제출 재알림" }
      },
      {
        "type": "section",
        "text": { "type": "mrkdwn", "text": "금일 업무 보고를 작성해주시기 바랍니다.\n확인 후 작성을 부탁드립니다." }
      },
      { "type": "divider" },
      {
        "type": "section",
        "text": { "type": "mrkdwn", "text": `*대상자:*\n${mentions}` }
      },
      {
        "type": "context",
        "elements": [{ "type": "mrkdwn", "text": "이미 작성하셨다면 형식이 올바른지 확인해주세요." }]
      }
    ];

    postBlocksToSlack(BRIEFING_CHANNEL_ID, "업무 보고 제출 재알림", blocks);
    Logger.log(`미제출자 알림 전송 완료: ${mentions}`);
  } else {
    Logger.log('모든 대상자가 업무 보고를 제출했습니다.');
  }
}

