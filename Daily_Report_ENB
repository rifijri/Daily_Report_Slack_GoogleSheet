  }
}

// ---------------------------------------------------------------------------
// 6. Slack Briefing Builder (ENB 전용 채널 뷰 + 전사 포맷 적용)
// ---------------------------------------------------------------------------

function buildBriefingBlocks(aggregated, totalCount, summaries) {
  const dateLabel = Utilities.formatDate(new Date(), TZ, DATE_BRIEFING_FORMAT);
  const blocks = [];

  blocks.push({
    type: 'header',
    text: { type: 'plain_text', text: ':clipboard: 전일 업무 브리핑 | ' + dateLabel, emoji: true }
  });
  blocks.push({
    type: 'section',
    text: { type: 'mrkdwn', text: '어제 총 ' + totalCount + '건의 업무가 보고되었습니다.' }
  });
  blocks.push({ type: 'divider' });

  blocks.push({
    type: 'section',
    text: {
      type: 'mrkdwn',
      text: '*핵심 3줄 요약*\n1. ' + (summaries[0] || '-') + '\n2. ' + (summaries[1] || '-') + '\n3. ' + (summaries[2] || '-')
    }
  });
  blocks.push({ type: 'divider' });
  blocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*:bar_chart: 상세 업무 현황*' } });

  aggregated.channels.forEach(ch => {
    if (ch.members.length === 0) return;

    // ENB 전용 헤더
    const channelHeader = `*Corporate Operator 셀*`;
    const memberTexts = [];

    ch.members.forEach(m => {
      const blockText = formatMemberBlock(m);
      if (blockText && blockText.trim() !== "") {
        memberTexts.push(blockText.trim());
      }
    });

    if (memberTexts.length === 0) return;

    let channelBody = memberTexts.join('\n\n\n');
    if (channelBody.length > 2900) {
      channelBody = channelBody.substring(0, 2900) + "...(내용 생략됨)";
    }

    blocks.push({
      type: "section",
      text: { type: "mrkdwn", text: `${channelHeader}\n\n${channelBody}` }
    });
    blocks.push({ type: 'divider' });
  });

  return blocks;
}

// 렌더링 방식에 전사 기준 (전날 한 일 / 오늘 할 일 / 고민) 적용
function formatMemberBlock(m) {
  const clean = (txt) => {
    if (!txt || txt === '-') return [];
    return txt.split(/\r?\n/).filter(line => {
      const rawText = line.replace(/^[-•*]\s*/, '').trim();
      return rawText !== '' && rawText !== '내용 없음' && rawText !== '내용없음';
    });
  };

  const yesterday = clean(m.yesterday);
  const today = clean(m.today);
  const challenges = clean(m.challenges);

  if (yesterday.length === 0 && today.length === 0 && challenges.length === 0) return "";

  const lines = ['*' + m.name + '*'];
  
  const processLines = (textArray) => {
    textArray.forEach(line => {
      let trimmed = line.trim();
      trimmed = trimmed.replace(/^[-•*]\s*/, '');
      if (trimmed.startsWith('http')) {
        lines.push(`    ${trimmed}`); 
      } else {
        lines.push(` • ${trimmed}`);
      }
    });
  };

  if (yesterday.length > 0) {
    lines.push('_전날 한 일:_');
    processLines(yesterday);
  }

  if (today.length > 0) {
    lines.push('_오늘 할 일:_');
    processLines(today);
  }
  
  if (challenges.length > 0) {
    lines.push('_고민했던 부분과 해결한 결과:_');
    processLines(challenges);
  }
  
  return lines.join('\n');
}

function postBlocksToSlack(channelId, fallbackText, blocks) {
  UrlFetchApp.fetch("https://slack.com/api/chat.postMessage", {
    method: "post",
    contentType: "application/json",
    headers: { "Authorization": "Bearer " + SLACK_TOKEN },
    payload: JSON.stringify({ channel: channelId, text: fallbackText, blocks: blocks }),
    muteHttpExceptions: true
  });
}
