function callOpenAIParser(text) {
  if (text == null || typeof text !== 'string') {
    return { isRelevant: false, name: '미기입', yesterday: '-', today: '-', challenges: '-', squad_yesterday: [], squad_today: [], squad_challenges: [] };
  }
  text = String(text).trim();
  if (!text) {
    return { isRelevant: false, name: '미기입', yesterday: '-', today: '-', challenges: '-', squad_yesterday: [], squad_today: [], squad_challenges: [] };
  }

  const validSquads = Object.values(PLATOON_CONFIG).reduce((acc, curr) => acc.concat(curr.squads), []).join(', ');

  // 전사 AI 프롬프트를 토씨 하나 안 틀리고 그대로 이식
  const systemPrompt = 
    "너는 '데이터 정제 및 추출 전문가'야. 입력된 텍스트에서 업무 보고 데이터를 구조화된 JSON으로 추출해.\n\n" +
    
    "**1. 기본 규칙 (isRelevant)**:\n" +
    "   - '전날 한 일' 또는 '오늘 할 일' 어휘가 있고 업무내용이 있으면 **true**. 단순 인사말이면 false.\n\n" +

    "**2. 시트용 원본 데이터 (yesterday, today, challenges 추출)**:\n" +
    "   - **yesterday**: 입력된 텍스트에서 '전날 한 일' 하위의 전체 내용을 하나의 문자열로 반환.\n" +
    "   - **today**: 입력된 텍스트에서 '오늘 할 일' 하위의 전체 내용을 하나의 문자열로 반환.\n" +
    "   - **challenges**: 입력된 텍스트에서 '고민했던 부분과 해결한 결과' 하위의 전체 내용을 하나의 문자열로 반환.\n" +
    "   - 단, 링크 라벨('지라:', '컨플루언스:')은 제거하고 순수 URL만 줄바꿈(\\n)으로 보존해.\n\n" +

    "**3. 브리핑용 스쿼드 분할 데이터 (squad_yesterday, squad_today, squad_challenges 배열)**:\n" +
    "   - 담당자가 작성한 텍스트에서 'OO스쿼드:', '[DT]', 'WG' 등 **스쿼드 명칭**을 감지해.\n" +
    `   - 유효한 스쿼드 키 목록: [${validSquads}]\n` +
    "   - **명시되지 않거나 유효하지 않은 스쿼드는 무조건 '공통' 스쿼드로 할당해.**\n" +
    "   - **squad_yesterday**, **squad_today**, **squad_challenges**를 각각 객체 배열로 반환해.\n" +
    "     형식: { \"squad\": \"DT\", \"content\": \"- 로그인 API 구현\\nhttp://...\" }\n\n" +

    "**[출력 예시]**\n" +
