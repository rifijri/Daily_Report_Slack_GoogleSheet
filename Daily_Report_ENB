function attachJiraDueToAggregated_(aggregated) {
  try {
    const dueMap = fetchJiraDueBucketsBySlackId_();
    
    // 1. 슬랙에 보고서를 작성한 멤버들에게 Jira 내용 붙이기
    aggregated.channels.forEach(ch => {
      ch.members.forEach(m => {
        const bucket = dueMap[m.id];
        if (!bucket) return;

        const lines = [];

        bucket.overdue.forEach(it => {
          lines.push(`- [JIRA OVERDUE] ${it.key}: ${it.summary} (due ${it.due})`);
          lines.push(it.url);
        });

        bucket.dueSoon.forEach(it => {
          lines.push(`- [JIRA DUE SOON] ${it.key}: ${it.summary} (due ${it.due})`);
          lines.push(it.url);
        });

        if (lines.length > 0) {
          m.backlog = appendBlock_(m.backlog, lines.join('\n'));
        }
        
        // 처리 완료된 멤버는 dueMap에서 제거 (미제출자 필터링을 위함)
        delete dueMap[m.id];
      });
    });

    // 2. 슬랙 보고서를 쓰지 않았지만 Jira 티켓이 남아있는 멤버를 브리핑에 강제 추가
    if (aggregated.channels.length > 0) {
      const mainChannel = aggregated.channels[0];
      
      Object.keys(dueMap).forEach(slackId => {
        const bucket = dueMap[slackId];
        const lines = [];
        
        bucket.overdue.forEach(it => {
          lines.push(`- [JIRA OVERDUE] ${it.key}: ${it.summary} (due ${it.due})`);
          lines.push(it.url);
        });
        bucket.dueSoon.forEach(it => {
          lines.push(`- [JIRA DUE SOON] ${it.key}: ${it.summary} (due ${it.due})`);
          lines.push(it.url);
        });

        // 덧붙일 내용이 있다면 멤버 객체를 새로 생성해서 배열에 넣음
        if (lines.length > 0) {
          const memberName = TARGET_MEMBERS[slackId] || '이름 알 수 없음';
          mainChannel.members.push({
            id: slackId,
            name: memberName,
            duties: '-', // [수정됨] '슬랙 업무 보고 미제출' 텍스트 제거하고 빈 값 처리
            backlog: lines.join('\n'),
            time: '-'
          });
        }
      });
    }

  } catch (e) {
    Logger.log('🚨 [Jira API Error] 데이터 조회 실패! 에러 원인을 확인하세요:');
    Logger.log(e.message);
  }
  return aggregated;
}

function appendBlock_(original, extra) {
  const orig = (original || '').trim();
  const ext = (extra || '').trim();
  if (!ext) return orig || '-';
  if (!orig || orig === '-') return ext;
  return orig + '\n' + ext;
}


