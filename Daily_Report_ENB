function sendUnsubmittedReminder() {
  const dayOfWeek = Utilities.formatDate(new Date(), TZ, 'EEE');
  if (dayOfWeek === 'Sat' || dayOfWeek === 'Sun') return;

  const oldest = getOldestTimestampSince7amKst();
  const submittedIds = new Set();

  CHANNELS.forEach(ch => {
    const messages = fetchSlackHistory(ch.id, oldest);
    messages.forEach(msg => {
      // 전사 기준 키워드 검사 적용
      if (msg.text && /전날\s*한\s*일|오늘\s*할\s*일/i.test(msg.text)) {
