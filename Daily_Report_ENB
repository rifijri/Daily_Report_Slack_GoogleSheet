function getOldestTimestampSince7amKst() {
  const now = new Date();
  const utcMs = now.getTime();
  const kstMs = utcMs + 9 * 60 * 60 * 1000;
  const kstDate = new Date(kstMs);
  let hour = kstDate.getUTCHours();
  const min = kstDate.getUTCMinutes();
  const sec = kstDate.getUTCSeconds();
  let secondsSinceStart = (hour - COLLECTION_START_HOUR_KST) * 3600 + min * 60 + sec;
  if (hour < COLLECTION_START_HOUR_KST) {
    secondsSinceStart += 24 * 3600;
  }
  return Math.floor(utcMs / 1000) - secondsSinceStart;
}

